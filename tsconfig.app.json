{
  "include": ["src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "skipLibCheck": true,

    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
